# SentinelStack environment configuration
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=http://localhost:8000

# SQLite path (relative to project root, or absolute)
DB_PATH=./data/sentinelstack.sqlite

# Session name
SESSION_NAME=sentinelstack_session

# Session cookie lifetime in seconds (0 = until browser closes)
SESSION_LIFETIME=0

# Set to "true" only when serving over HTTPS
SESSION_SECURE=false

# CSRF token lifetime in seconds (4 hours default)
CSRF_LIFETIME=14400

# Login rate limit: failed attempts per window
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# ─── Notification email side-channel ─────────────────────────
#
# When SEND_NOTIFICATIONS_EMAIL=true, every fired reminder (where the
# per-kind "Email me too" opt-in is also checked) goes out as a
# plain-text email. Delivery uses one of FOUR transports, picked
# automatically in this priority order:
#
#   1. MAILGUN_API_KEY + MAILGUN_DOMAIN set → Mailgun HTTP API
#   2. RESEND_API_KEY set                   → Resend HTTP API
#   3. NOTIFICATION_SMTP_HOST set           → raw SMTP via fsockopen
#   4. nothing set                          → PHP's mail() (local MTA)
#
# Off by default so a self-hosted install without a working relay is
# silent instead of flooding the postfix queue. Turn it on after you
# have verified the relay works for you.
SEND_NOTIFICATIONS_EMAIL=false

# Used as the From: / envelope-sender address on outbound emails. Set
# this to a real address on a domain you control — many SMTP relays
# (Gmail, SES, Mailgun, Resend) reject mail pretending to be from
# `sentinelstack@localhost` for SPF/DKIM reasons.
NOTIFICATION_FROM_EMAIL=sentinelstack@localhost

# ─── Mailgun HTTP transport (primary; tried first if configured) ───
# Sign up at https://www.mailgun.com, create a sandbox or verified
# domain, and generate an API key. The sandbox domain requires
# account activation (check your inbox) before it can send.
#
# Mailgun is the recommended transport — its free tier (100 emails/day
# with a sandbox domain) allows sending to any recipient without
# needing a custom domain.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ─── Resend HTTP transport (only used if RESEND_API_KEY is set) ───
# Alternative to Mailgun. Sign up at https://resend.com.
# Note: the free onboarding sender (onboarding@resend.dev) can only
# send to the email used to create the Resend account.
# Verify a domain to send to any recipient.
RESEND_API_KEY=

# ─── Direct SMTP transport (only used if NOTIFICATION_SMTP_HOST is set) ───
# Point at any SMTP relay. Tested patterns:
#   Gmail:      host=smtp.gmail.com        port=587  encryption=starttls
#   Mailgun:    host=smtp.mailgun.org      port=587  encryption=starttls
#   Postmark:   host=smtp.postmarkapp.com  port=587  encryption=starttls
#   SES:        host=email-smtp.<region>.amazonaws.com  port=587  encryption=starttls
#   Local dev:  host=127.0.0.1             port=1025 encryption=none
#
# Encryption values:
#   starttls — connect plain, upgrade to TLS after EHLO (port 587 typical)
#   tls      — implicit TLS from the first byte (port 465 typical)
#   none     — no encryption (only safe on a trusted LAN; local dev only)
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASS=
NOTIFICATION_SMTP_ENCRYPTION=starttls
